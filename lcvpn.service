[Unit]
Description=Light decentralized VPN in golang
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/opt/lcvpn
Restart=always
RestartSec=2

# CAP_NET_ADMIN for the TUN device and routes, CAP_NET_BIND_SERVICE for ports below 1024.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
# AF_UNIX: hostname resolution through nscd or systemd-resolved with the cgo resolver.
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw

[Install]
WantedBy=multi-user.target
